# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix will download dependencies to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files, in case you like to edit your project specs locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it
erl_crash.dump

# Also ignore archive artifacts (e.g. from packages)
*.ez
*.tar
*.beam

# Generated by Phoenix
/priv/static/assets/
/priv/static/cache_manifest.json

# Generated by SQLite
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.db
*.db-shm
*.db-wal
/db/

# Node / Frontend assets
/assets/node_modules/
node_modules/

# Temporary files
/tmp/

# Elixir Language Server & IDE files
.elixir_ls/
.lexical/
.vscode/
.idea/

# Environment files
.env
.env.*
!.env.example

# OS files
.DS_Store
Thumbs.db
